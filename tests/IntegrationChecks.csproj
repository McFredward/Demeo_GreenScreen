<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Game Condition="'$(Game)' == ''">DEMEO</Game>
    <LoaderBackend Condition="'$(LoaderBackend)' == '' And '$(Game)' == 'DEMEOBATTLEMARKED'">MelonLoader</LoaderBackend>
    <LoaderBackend Condition="'$(LoaderBackend)' == ''">BepInEx</LoaderBackend>
    <DefineConstants>$(DefineConstants);$(Game)</DefineConstants>
    <DefineConstants Condition="'$(LoaderBackend)' == 'MelonLoader'">$(DefineConstants);MELONLOADER</DefineConstants>
    <OutputPath>bin/Integration/$(LoaderBackend)/$(Game)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ModEntryPoints.cs;../ModConfiguration.cs;../NativePassthrough.cs;../OpaqueCoverage.cs;../SrpOutput.cs;../SrpOpaqueCoverage.cs;../SrpAlphaProbe.cs;../SteamLinkConnectionLifecycle.cs;../OpenVrStereoLayout.cs;../OpenVrNativeSettings.cs" />
    <Compile Include="UnityBoundary.cs;IntegrationChecks.cs;OpenVrStereoChecks.cs" />
    <EmbeddedResource Include="../assets/nativecoverage.bundle" LogicalName="GreenScreen.NativeCoverage" />
  </ItemGroup>
</Project>
