<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TestTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(TestTargetFramework)' != ''">$(TestTargetFramework)</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Game Condition="'$(Game)' == ''">DEMEO</Game>
    <LoaderBackend Condition="'$(LoaderBackend)' == '' And '$(Game)' == 'DEMEOBATTLEMARKED'">MelonLoader</LoaderBackend>
    <LoaderBackend Condition="'$(LoaderBackend)' == ''">BepInEx</LoaderBackend>
    <DefineConstants>$(DefineConstants);$(Game)</DefineConstants>
    <DefineConstants Condition="'$(LoaderBackend)' == 'MelonLoader'">$(DefineConstants);MELONLOADER</DefineConstants>
    <OutputPath>bin/Integration/$(LoaderBackend)/$(Game)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ModEntryPoints.cs;../ModConfiguration.cs;../NativePassthrough.cs;../OpaqueCoverage.cs;../SrpOutput.cs;../SrpOpaqueCoverage.cs;../SrpAlphaProbe.cs;../SteamLinkConnectionLifecycle.cs;../OpenVrSubmission.cs;../OpenVrEyeSubmission.cs;../OpenVrEyeTextures.cs;../OpenVrNativeSettings.cs;../OpenVrOrigin.cs" />
    <Compile Include="UnityBoundary.cs;IntegrationChecks.cs;OpenVrSubmissionChecks.cs;NativeSubmitChecks.cs;OpenVrOriginChecks.cs" />
    <EmbeddedResource Include="../assets/nativecoverage.bundle" LogicalName="GreenScreen.NativeCoverage" />
  </ItemGroup>
</Project>
