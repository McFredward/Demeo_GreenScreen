<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>DEMEO;DEMEOBATTLES;DEMEOBATTLEMARKED</Configurations>
    <Version>1.4.0</Version>
    <TargetFramework Condition="'$(Configuration)' == 'DEMEO'">netstandard2.1</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' != 'DEMEO'">net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <LoaderBackend Condition="'$(LoaderBackend)' == '' And '$(Configuration)' == 'DEMEOBATTLEMARKED'">MelonLoader</LoaderBackend>
    <LoaderBackend Condition="'$(LoaderBackend)' == ''">BepInEx</LoaderBackend>
    <!-- All games expose the same assembly names. Never resolve another game's
         metadata DLL from SDK candidate-file globs before this HintPath. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <DefineConstants>$(DefineConstants);$(Configuration)</DefineConstants>
    <DefineConstants Condition="'$(LoaderBackend)' == 'MelonLoader'">$(DefineConstants);MELONLOADER</DefineConstants>
    <OutputPath>bin/$(LoaderBackend)/$(Configuration)</OutputPath>
    <AssemblyName Condition="'$(Configuration)' == 'DEMEO'">Demeo_GreenScreen</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'DEMEOBATTLES'">DemeoBattles_GreenScreen</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'DEMEOBATTLEMARKED'">DemeoBattlemarked_GreenScreen</AssemblyName>
    <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps/common</SteamLibraryPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DEMEO'">
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(SteamLibraryPath)/Demeo</GameDirectory>
    <UnityAssemblyDirectory Condition="'$(UnityAssemblyDirectory)' == ''">$(GameDirectory)/demeo_Data/Managed</UnityAssemblyDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DEMEOBATTLES'">
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(SteamLibraryPath)/Demeo Battles</GameDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DEMEOBATTLEMARKED'">
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(SteamLibraryPath)/Battlemarked</GameDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LoaderBackend)' == 'BepInEx'">
    <LoaderDirectory Condition="'$(LoaderDirectory)' == ''">$(GameDirectory)/BepInEx/core</LoaderDirectory>
    <UnityAssemblyDirectory Condition="'$(UnityAssemblyDirectory)' == ''">$(GameDirectory)/BepInEx/interop</UnityAssemblyDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LoaderBackend)' == 'MelonLoader'">
    <LoaderDirectory Condition="'$(LoaderDirectory)' == '' And '$(Configuration)' == 'DEMEO' And Exists('$(GameDirectory)/MelonLoader/net472/MelonLoader.dll')">$(GameDirectory)/MelonLoader/net472</LoaderDirectory>
    <LoaderDirectory Condition="'$(LoaderDirectory)' == '' And '$(Configuration)' == 'DEMEO'">$(GameDirectory)/MelonLoader/net35</LoaderDirectory>
    <LoaderDirectory Condition="'$(LoaderDirectory)' == ''">$(GameDirectory)/MelonLoader/net6</LoaderDirectory>
    <UnityAssemblyDirectory Condition="'$(UnityAssemblyDirectory)' == ''">$(GameDirectory)/MelonLoader/Il2CppAssemblies</UnityAssemblyDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <UseReferenceAssemblies Condition="'$(UseReferenceAssemblies)' == '' And !Exists('$(UnityAssemblyDirectory)/UnityEngine.CoreModule.dll')">true</UseReferenceAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseReferenceAssemblies)' == 'true'">
    <UnityAssemblyDirectory>$(MSBuildThisFileDirectory)libs/RefAsm/$(Configuration)</UnityAssemblyDirectory>
    <LoaderDirectory>$(MSBuildThisFileDirectory).build/loaders/$(LoaderBackend)/$(Configuration)</LoaderDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;unity/**/*.cs;.planning/**/*.cs" />
    <EmbeddedResource Include="assets/nativecoverage.bundle" LogicalName="GreenScreen.NativeCoverage" />
    <EmbeddedResource Include="assets/steamlink/connection-reader.exe" LogicalName="GreenScreen.SteamLink.connection-reader.exe" />
    <EmbeddedResource Include="assets/steamlink/openvr_api.bin" LogicalName="GreenScreen.SteamLink.openvr_api.dll" />
    <None Update="greenscreen.ini.example" TargetPath="greenscreen.ini" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="0Harmony" HintPath="$(LoaderDirectory)/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(UnityAssemblyDirectory)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityAssemblyDirectory)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.XRModule" HintPath="$(UnityAssemblyDirectory)/UnityEngine.XRModule.dll" Private="false" />
    <Reference Include="UnityEngine.SubsystemsModule" HintPath="$(UnityAssemblyDirectory)/UnityEngine.SubsystemsModule.dll" Private="false" />
    <Reference Include="UnityEngine.VRModule" HintPath="$(UnityAssemblyDirectory)/UnityEngine.VRModule.dll" Private="false"
               Condition="Exists('$(UnityAssemblyDirectory)/UnityEngine.VRModule.dll')" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(UnityAssemblyDirectory)/UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(LoaderBackend)' == 'MelonLoader'">
    <Reference Include="MelonLoader" HintPath="$(LoaderDirectory)/MelonLoader.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(LoaderBackend)' == 'BepInEx' And '$(Configuration)' == 'DEMEO'">
    <Reference Include="BepInEx" HintPath="$(LoaderDirectory)/BepInEx.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(LoaderBackend)' == 'BepInEx' And '$(Configuration)' != 'DEMEO'">
    <Reference Include="BepInEx.Core" HintPath="$(LoaderDirectory)/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(LoaderDirectory)/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(LoaderDirectory)/BepInEx.Unity.IL2CPP.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'DEMEO'">
    <Reference Include="Il2Cppmscorlib" HintPath="$(UnityAssemblyDirectory)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(LoaderDirectory)/Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameConfiguration" BeforeTargets="ResolveReferences">
    <Error Condition="'$(LoaderBackend)' != 'BepInEx' And '$(LoaderBackend)' != 'MelonLoader'"
           Text="Select LoaderBackend=BepInEx or LoaderBackend=MelonLoader." />
    <Message Condition="'$(UseReferenceAssemblies)' == 'true'" Importance="high"
             Text="Building $(Configuration) against metadata-only references (no local game code)." />
    <Error Condition="'$(Configuration)' != 'DEMEO' And '$(Configuration)' != 'DEMEOBATTLES' And '$(Configuration)' != 'DEMEOBATTLEMARKED'"
           Text="Select -c DEMEO, -c DEMEOBATTLES or -c DEMEOBATTLEMARKED." />
    <Error Condition="!Exists('$(UnityAssemblyDirectory)/UnityEngine.CoreModule.dll')"
           Text="Game assemblies are missing. Set GameDirectory (and optionally UnityAssemblyDirectory/LoaderDirectory) to the installed game and mod loader." />
  </Target>
</Project>
