[COLOR]
R=0
G=255
B=0

[TABLE]
Disable=true

[STEAMLINK]
; Effective only on a detected Steam Frame connected through Steam Link.
; Other headsets/transports automatically use the colour-key background.
NativePassthrough=true
# Include lossless mask traffic in the sender video budget (PC patch 0.2.15+).
# May increase video compression under load; resolution/FPS and mask precision stay unchanged.
AccountMaskBandwidth=true
